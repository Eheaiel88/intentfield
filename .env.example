# Populate the matching development deployment with `npx convex dev --configure existing`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Pull with `clerk env pull --instance dev` after linking the IntentField app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Also set this on the Convex deployment with `npx convex env set`.
CLERK_JWT_ISSUER_DOMAIN=
# Exact deployed website origin; local development also permits port 3000.
APP_ORIGIN=https://myintentfield.com

# Whop embedded-surface identity. A private ES256 JWK that signs the
# short-lived Convex tokens minted after x-whop-user-token verification.
# Generate a pair with jose; put the public half (as a base64 data-URI JWKS)
# on the Convex deployment: `npx convex env set WHOP_CONVEX_JWKS data:...`.
WHOP_CONVEX_SIGNING_KEY=
# Optional override of Whop's public token-verification JWK (key rotation).
# WHOP_USER_TOKEN_PUBLIC_JWK=

# Whop checkout/webhook credentials remain pending (integration phases 3-4).
# The admin MCP connection is not a runtime application credential.
