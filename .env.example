# Populate the matching development deployment with `npx convex dev --configure existing`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Pull with `clerk env pull --instance dev` after linking the IntentField app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Also set this on the Convex deployment with `npx convex env set`.
CLERK_JWT_ISSUER_DOMAIN=
# Exact deployed website origin; local development also permits port 3000.
APP_ORIGIN=https://myintentfield.com

# Whop runtime credentials and purchase configuration remain pending.
# The admin MCP connection is not a runtime application credential.
